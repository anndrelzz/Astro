{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Rastros (Tempo)",
      "description": "A fonte grafanacloud-...-traces do stack do Astro",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "tempo",
      "name": "Tempo",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "__expr__",
      "name": "Expression",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "uid": "astro-producao",
  "title": "Astro — Produção",
  "description": "Pedidos, erros e tempo de resposta do useastro.app.br, a partir dos rastros OpenTelemetry (src/back/telemetria.ts). Versionado em infra/grafana/painel-astro.json.",
  "tags": [
    "astro",
    "producao"
  ],
  "timezone": "America/Sao_Paulo",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pedidos no período",
      "description": "Quantos pedidos (páginas e rotas da API) o site atendeu no intervalo escolhido no topo.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server} | count_over_time()",
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Pedidos com erro do servidor",
      "description": "Quantos pedidos terminaram em erro do servidor (5xx) no período. O ideal é zero.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server && (status=error || span.http.status_code >= 500)} | count_over_time()",
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Tempo de resposta (p95)",
      "description": "95% dos pedidos responderam em até este tempo. O RNF02 pede a lista de horários em menos de 300 ms. O valor é estimado por faixas de tempo (arredonda para o teto da faixa): use a lista de pedidos lentos para ver o tempo exato.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server} | quantile_over_time(duration, .95)",
          "metricsQueryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Horários (/api/slots) p95",
      "description": "Tempo da rota que monta a lista de horários livres. Meta do RNF02: abaixo de 300 ms. O valor é estimado por faixas de tempo (arredonda para o teto da faixa): use a lista de pedidos lentos para ver o tempo exato.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server && name=~\".*/api/slots.*\"} | quantile_over_time(duration, .95)",
          "metricsQueryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "sem pedidos",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pedidos por rota",
      "description": "Pedidos por segundo em cada página e rota da API.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server} | rate() by (name)",
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*name=\"([^\"]*)\".*",
            "renamePattern": "$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(GET|POST|PUT|PATCH|DELETE)$",
            "renamePattern": "$1 (rota inexistente)"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tempo de resposta (p95) por rota",
      "description": "95% dos pedidos de cada rota responderam em até este tempo. O valor é estimado por faixas de tempo (arredonda para o teto da faixa): use a lista de pedidos lentos para ver o tempo exato.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server} | quantile_over_time(duration, .95) by (name)",
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*name=\"([^\"]*)\".*",
            "renamePattern": "$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(GET|POST|PUT|PATCH|DELETE)$",
            "renamePattern": "$1 (rota inexistente)"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Respostas por código HTTP",
      "description": "2xx = deu certo, 3xx = redirecionou, 4xx = pedido inválido ou sem login, 5xx = erro do servidor.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server} | count_over_time() by (span.http.status_code)",
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Últimos pedidos com erro",
      "description": "Clique no Trace ID para abrir o rastro e ver em que etapa o pedido falhou.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server && (status=error || span.http.status_code >= 500)}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Pedidos lentos (mais de 1 s)",
      "description": "Pedidos que passaram de 1 segundo. Clique no Trace ID para ver qual etapa demorou.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"astro\" && resource.deployment.environment.name=\"producao\" && kind=server && duration > 1s}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
