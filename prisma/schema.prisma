// Schema do Astro — SaaS de gestao para esteticas automotivas
// Modelo de dados conforme RFC v1.0, secao 5.2 (Figura 9 — Diagrama ER)
//
// Nota de arquitetura (M1, RNF06): Row-Level Security esta ativo no banco
// (migration 20260723_rls) para usuario, veiculo, servico, agendamento,
// horario_funcionamento e notificacao, mais segmento e preco_servico
// (migration 20260929_segmentos_editaveis). As policies filtram por
// current_setting('app.tenant_id') — o codigo da aplicacao DEVE rodar
// toda leitura/escrita nessas tabelas atraves de withTenant()
// (src/lib/tenant-db.ts), que abre uma transacao e seta essa GUC via
// SET LOCAL. O filtro explicito por tenantId no codigo continua sendo
// exigido como segunda camada de defesa — RLS nao substitui isso.
// Tenant fica de fora do RLS: e o diretorio publico consultado por
// slug antes de existir sessao (login/cadastro).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENTE
}

enum StatusAgendamento {
  PENDENTE_PAGAMENTO
  PIX_PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

enum FormaPagamento {
  PIX
  LOCAL
}

enum TipoNotificacao {
  CONFIRMACAO_AGENDAMENTO
  LEMBRETE_24H
  LEMBRETE_2H
  CONFIRMACAO_CANCELAMENTO
  RESERVA_PIX
  PAGAMENTO_CONFIRMADO
  AVISO_NOVO_AGENDAMENTO
  AVISO_CANCELAMENTO
}

enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHA
}

/// Cada aviso vira uma linha por canal, com status e tentativas proprios.
enum CanalNotificacao {
  EMAIL
  TELEGRAM
}

/// Cada estetica cadastrada e um tenant isolado (RN07).
/// slug e unico e imutavel apos o cadastro (RN09).
model Tenant {
  id          String  @id @default(uuid())
  nome        String
  slug        String  @unique
  logoUrl     String?
  corPrimaria String?
  /// Apresentacao da estetica, exibida ao cliente no site publico (UC13).
  descricao   String?

  // Contato e localizacao — tudo exibido ao cliente. Como cada estetica tem um
  // endereco so, sao colunas daqui e nao tabela separada: tabela propria seria
  // o caso de filiais, que estao em Fora do Escopo (RFC 2.6).
  telefone     String?
  whatsapp     String?
  emailContato String?
  cep          String?
  rua          String?
  numero       String?
  bairro       String?
  cidade       String?
  estado       String?
  pixChaveCopiaCola       String? // RF17 — se nulo, opcao PIX nao e exibida ao cliente (RN10)
  /// Acrescimo maximo, em %, que a estetica pode cobrar quando o veiculo chega
  /// em condicao muito ruim (pedido da EstimaCar: ate 30% na lavacao). NULO =
  /// a estetica nao tem essa politica, e o cliente nao ve aviso nenhum — mesmo
  /// padrao da RN10 com a chave PIX.
  ///
  /// O valor do agendamento continua sendo o calculado pelo segmento (RN01); o
  /// acrescimo e avaliado presencialmente e a diferenca e paga no local,
  /// inclusive quando o cliente ja pagou por PIX.
  acrescimoCondicaoPercent Int?
  cancelamentoHorasLimite Int      @default(2) // RF18 — antecedencia minima para cancelamento pelo cliente
  capacidadeSimultanea    Int      @default(1) // RN06 — configurada pelo Admin, numero de atendimentos ao mesmo tempo
  /// E-mail ao dono a cada novo agendamento e cancelamento feito pelo cliente
  /// (AVISO_NOVO_AGENDAMENTO e AVISO_CANCELAMENTO). Liga e desliga nas Configuracoes.
  avisosPorEmail          Boolean  @default(true)
  intervaloMinutos        Int      @default(60) // RF02 — granularidade dos horarios oferecidos
  /// Autocadastro (06/11): resumo (SHA-256 com segredo) da conexao que criou a
  /// estetica pela tela /start, para o limite de cadastros por hora. Nunca o
  /// IP em si (LGPD). NULO = criada pelo script do terminal.
  cadastroIpHash          String?
  criadoEm                DateTime @default(now())

  usuarios     Usuario[]
  veiculos     Veiculo[]
  servicos     Servico[]
  segmentos    Segmento[]
  precos       PrecoServico[]
  agendamentos Agendamento[]
  horarios     HorarioFuncionamento[]
  notificacoes Notificacao[]
  logo         LogoTenant?
  tokensEmail  TokenEmail[]

  @@index([cadastroIpHash, criadoEm])
  @@map("tenant")
}

/// Arquivo do logo da estetica (UC12, RF13). `tenant.logoUrl` continua sendo o
/// endereco que as telas usam; o que mudou e onde os bytes moram.
///
/// Antes ficavam em public/uploads/logos, no disco do servidor — que o App
/// Service apaga a cada deploy/restart e a Vercel nem deixa gravar. No banco o
/// logo vai junto para qualquer hospedagem, sem conta nem chave a mais. Cabe
/// aqui porque e um arquivo de ate 2MB por estetica; com muitos arquivos ou
/// arquivos grandes o lugar certo seria um Blob Storage.
///
/// Tabela propria, e nao coluna em tenant: quase toda pagina busca o tenant
/// inteiro (findUnique sem select) e passaria a carregar a imagem junto.
model LogoTenant {
  tenantId     String   @id
  dados        Bytes
  /// MIME conferido pelos primeiros bytes do arquivo, nao pelo que o navegador
  /// declarou.
  tipo         String
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("logo_tenant")
}

/// Tipos de veiculo que a estetica atende, definidos por ela (RN01 revisada).
///
/// Antes era o enum SegmentoVeiculo, fixo no sistema: HATCH/SEDAN/SUV/PICKUP/VAN
/// para todo mundo. Pedido do cliente real (EstimaCar, 20/09): ele nao atende VAN
/// e cobra diferente de picape pequena e picape grande. Lista fixa obrigava a
/// inventar preco para segmento que ele nao atende e nao permitia o que ele
/// atende — sobrava e faltava ao mesmo tempo.
///
/// `ativo` segue o mesmo padrao de RN14 (servico) e RN15 (veiculo): remover de
/// verdade so quando nada aponta para ele; caso contrario aposenta, some das
/// escolhas e o historico continua legivel.
model Segmento {
  id       String  @id @default(uuid())
  tenantId String
  nome     String
  /// Ordem de exibicao na vitrine e nas colunas do catalogo do Admin.
  ordem    Int
  ativo    Boolean @default(true)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  veiculos Veiculo[]
  precos   PrecoServico[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@map("segmento")
}

/// Preco de um servico para um segmento (RF01, RF04). Substitui as cinco
/// colunas fixas precoHatch..precoVan de Servico.
///
/// Todo servico precisa de preco para todo segmento ativo do tenant — decisao
/// do Andre em 29/09: como a lista de segmentos agora e da propria estetica,
/// segmento cadastrado e segmento que ela atende, entao nao existe combinacao
/// legitimamente sem preco.
model PrecoServico {
  id         String  @id @default(uuid())
  tenantId   String
  servicoId  String
  segmentoId String
  valor      Decimal @db.Decimal(10, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  servico  Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  segmento Segmento @relation(fields: [segmentoId], references: [id])

  @@unique([servicoId, segmentoId])
  @@index([tenantId])
  @@map("preco_servico")
}

/// Grade semanal recorrente de funcionamento (RF02). Um intervalo por dia
/// da semana; ausencia de registro para um dia = estetica fechada nesse dia.
model HorarioFuncionamento {
  id            String @id @default(uuid())
  tenantId      String
  diaSemana     Int // 0 = domingo ... 6 = sabado (Date.getDay())
  horaInicioMin Int // minutos desde meia-noite, ex: 480 = 08:00
  horaFimMin    Int

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, diaSemana])
  @@map("horario_funcionamento")
}

/// Concentra clientes e admins. telegram_chat_id/telegram_link_token
/// suportam a vinculacao opcional de notificacoes (RN12).
model Usuario {
  id                String   @id @default(uuid())
  tenantId          String
  nome              String
  email             String
  senhaHash         String
  telefone          String?
  role              Role     @default(CLIENTE)
  telegramChatId    String? // RNF11 — uso exclusivo para notificacoes
  telegramLinkToken String?
  /// Cliente interno da estetica, pelo qual o Admin agenda quem chamou no
  /// WhatsApp ou no Instagram (decisao do orientador, 30/10). Um por estetica,
  /// sem e-mail real e com senha aleatoria: ninguem entra com ele, e os
  /// agendamentos dele nao geram notificacao.
  coringa           Boolean  @default(false)
  /// Quando o cliente provou que abre a caixa desse e-mail (link de
  /// confirmacao ou de redefinir a senha). NULO = ainda nao confirmado.
  emailConfirmadoEm DateTime?
  /// Limite de tentativas no login (issue #107). Conta as tentativas desde o
  /// ultimo acerto; na 5a errada, bloqueia ate `bloqueadoAte` (15 minutos).
  /// Acertar a senha ou redefini-la zera os dois. Ver back/limite-login.ts.
  tentativasErradas Int       @default(0)
  bloqueadoAte      DateTime?
  /// Resumo (HMAC) da conexao que fez o cadastro, para o limite de cadastros
  /// por hora (OWASP A04). O IP em si nao e guardado (LGPD).
  cadastroIpHash    String?
  criadoEm          DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  veiculos     Veiculo[]
  agendamentos Agendamento[]
  tokensEmail  TokenEmail[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, cadastroIpHash, criadoEm])
  @@map("usuario")
}

/// Cadastro obrigatorio antes do primeiro agendamento (RN04, UC02).
model Veiculo {
  id         String @id @default(uuid())
  tenantId   String
  usuarioId  String
  marca      String
  modelo     String
  placa      String
  ano        Int
  cor        String
  /// Aponta para um Segmento do proprio tenant (antes era o enum fixo).
  segmentoId String
  /// RN15 — veiculo aposentado sai da garagem e da escolha no agendamento,
  /// mas preserva o historico. Necessario porque o agendamento aponta para o
  /// veiculo: apagar a linha destruiria o registro do que ja foi vendido.
  /// Veiculo sem nenhum agendamento e apagado de verdade e nunca chega aqui.
  ativo     Boolean         @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])
  segmento     Segmento      @relation(fields: [segmentoId], references: [id])
  agendamentos Agendamento[]

  @@index([usuarioId])
  @@index([tenantId])
  @@index([segmentoId])
  @@map("veiculo")
}

/// Preco por segmento de veiculo, calculado automaticamente no agendamento
/// e nunca alterado manualmente pelo cliente (RN01, RF01, RF04).
model Servico {
  id         String  @id @default(uuid())
  tenantId   String
  nome       String
  /// Exibida ao cliente no card do servico (UC08, mockup do site publico).
  descricao  String?
  /// RN14 — servico pausado sai da vitrine mas preserva o historico.
  /// Necessario porque um servico com agendamento vinculado NAO pode ser
  /// removido (apagar destruiria o registro do que ja foi vendido); sem
  /// "pausar", ele ficaria no catalogo do cliente para sempre.
  ativo      Boolean @default(true)
  duracaoMin Int

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  agendamentos Agendamento[]
  /// Um preco por segmento ativo do tenant — ver PrecoServico.
  precos       PrecoServico[]

  @@index([tenantId])
  @@map("servico")
}

/// Entidade transacional central (RN05, RN06). O horario e bloqueado
/// imediatamente na confirmacao, independente da forma de pagamento.
model Agendamento {
  id             String            @id @default(uuid())
  tenantId       String
  usuarioId      String
  veiculoId      String
  servicoId      String
  dataHora       DateTime
  status         StatusAgendamento @default(PENDENTE_PAGAMENTO)
  formaPagamento FormaPagamento
  valor          Decimal           @db.Decimal(10, 2)
  /// Duracao do servico QUANDO o agendamento foi feito, guardada como o
  /// `valor`: mudar a duracao no Catalogo vale so para os proximos
  /// agendamentos. Sem isso, aumentar a duracao "esticava" os agendamentos ja
  /// marcados e os fazia cruzar com os vizinhos.
  duracaoMin     Int
  /// Acrescimo cobrado na avaliacao presencial, lancado pelo Admin ao
  /// confirmar o pagamento. NULO = sem acrescimo.
  ///
  /// Fica ao lado do `valor` em vez de somar nele: `valor` e o que foi
  /// combinado com o cliente no agendamento e nao muda (RN01). Separados, o
  /// historico mostra "R$ 120,00 + R$ 36,00" para os dois lados e o financeiro
  /// consegue dizer quanto da receita veio de acrescimo.
  acrescimoAplicado Decimal? @db.Decimal(10, 2)
  /// Quando o Admin confirmou o pagamento (RF12). O financeiro conta a receita
  /// por esta data, e nao pelo dia do servico: um PIX pago hoje para a semana
  /// que vem e dinheiro que ja entrou na conta da estetica (regime de caixa).
  /// NULO = ainda nao pago. Os pagos antes desta coluna existir receberam o
  /// dia do servico (migration 20261103_agendamento_pago_em).
  pagoEm         DateTime?
  /// Quando o cliente apertou "Ja fiz o pagamento" na tela do PIX. NULO = nao
  /// avisou. Nao confirma nada (quem confirma e o Admin, RN05): so mostra no
  /// painel quais PIX conferir primeiro. Guarda o primeiro aviso.
  pagamentoInformadoEm DateTime?
  /// Quem chamou no WhatsApp, quando o Admin agenda pelo coringa. NULO nos
  /// agendamentos feitos pelo proprio cliente, que ja tem nome e telefone.
  contatoNome     String?
  contatoTelefone String?
  criadoEm       DateTime          @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])
  veiculo      Veiculo       @relation(fields: [veiculoId], references: [id])
  servico      Servico       @relation(fields: [servicoId], references: [id])
  notificacoes Notificacao[]

  @@index([tenantId])
  @@index([tenantId, dataHora])
  @@map("agendamento")
}

/// Log de envio (RNF08 / 6.4) — nunca armazena o conteudo da mensagem.
model Notificacao {
  id            String            @id @default(uuid())
  tenantId      String
  agendamentoId String
  tipo          TipoNotificacao
  canal         CanalNotificacao  @default(EMAIL)
  status        StatusNotificacao @default(PENDENTE)
  enviadoEm     DateTime?
  tentativas    Int               @default(0)
  criadoEm      DateTime          @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id])

  @@index([agendamentoId])
  @@index([tenantId])
  @@map("notificacao")
}

enum TipoTokenEmail {
  REDEFINIR_SENHA
  CONFIRMAR_EMAIL
}

/// Link enviado por e-mail (RFC 6.2: redefinir a senha; e a confirmacao do
/// e-mail). O token do link so existe no e-mail: aqui fica o sha256 dele,
/// para quem ler o banco nao conseguir usar os links abertos.
model TokenEmail {
  id        String         @id @default(uuid())
  tenantId  String
  usuarioId String
  tipo      TipoTokenEmail
  tokenHash String         @unique
  expiraEm  DateTime
  /// Preenchido no uso: o link vale uma vez so.
  usadoEm   DateTime?
  criadoEm  DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  // Cascade: link de uma conta apagada nao serve para nada, e sem isso a
  // conta com link aberto nao podia ser apagada (review do #103).
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([usuarioId, tipo])
  @@map("token_email")
}
