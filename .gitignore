# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploads de usuario (logos) - storage local so em dev, ver RF13
/public/uploads/*
!/public/uploads/.gitkeep

# configuracao local de ferramentas de desenvolvimento (por maquina, nao do
# projeto). O settings.local.json guarda comandos autorizados, incluindo
# strings com senha do banco local - nunca pode ir para o repositorio publico.
.claude/settings.local.json

# material de estudo pessoal, nao documentacao do projeto
MAPA-DO-PROJETO.md
